PROJECT_NAME="GPIE - Global Purchase Intent Engine"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database & Cache
DATABASE_URL=postgresql://gpie_user:gpie_password@localhost:5432/gpie_db
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Optional for local rule-based fallback)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Merchant Credentials
AMAZON_ASSOCIATES_TAG=
AMAZON_CREATORS_API_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Outreach & Tracking
BASE_URL=http://localhost:8000
AFFILIATE_DISCLOSURE_TEXT="Disclosure: We may earn an affiliate commission at no extra cost to you if you purchase through our links."
